+r"""The geometry-aware keypoint refinement network of NMT.
+
+The continuous-kernel convolution is selected by ``cfg.SPLINE_CNN.conv``:
+
+* ``"spline"`` uses :class:`rational_cnn.BSplineConv`, a pure-PyTorch
+  re-implementation of the SplineConv operator of SplineCNN (Fey et al.,
+  CVPR 2018). It is the same operator ``torch_geometric.nn.SplineConv``
+  computes, but needs no ``torch_spline_conv`` C++ extension.
+* ``"rational"`` uses :class:`rational_cnn.RationalConv`, which replaces the
+  fixed B-spline hats of that operator by learnable rational (safe-Pade)
+  basis functions, keeping everything else identical.
+
+Both come from the RationalBasisCNN project, so the two settings differ only
+in the basis functions and nothing else.
+"""
 import torch.nn
 import torch
 import torch.nn.functional as F
-from torch_geometric.nn import SplineConv
+
+from rational_cnn import BSplineConv, RationalConv
+
+from utils.config import cfg
+
+
+def make_conv(input_features, output_features):
+    r"""One continuous-kernel convolution, configured by ``cfg.SPLINE_CNN``."""
+    c = cfg.SPLINE_CNN
+    if c.conv == "spline":
+        return BSplineConv(input_features, output_features, c.dim,
+                           c.kernel_size, aggr=c.aggr, pyg_init=c.pyg_init)
+    if c.conv == "rational":
+        return RationalConv(input_features, output_features, c.dim,
+                            c.kernel_size, aggr=c.aggr, pyg_init=c.pyg_init,
+                            basis=c.rational_basis, vp=c.vp,
+                            degrees=tuple(c.degrees), safe=c.safe,
+                            poly=c.poly, init=c.init,
+                            init_noise=c.init_noise,
+                            num_bases=c.num_bases or None)
+    raise ValueError(f"unknown cfg.SPLINE_CNN.conv {c.conv!r}; "
+                     f"expected 'spline' or 'rational'")
 
 
